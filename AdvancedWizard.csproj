<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net48;net10.0-windows</TargetFrameworks>
		<UseWindowsForms>true</UseWindowsForms>
		<RootNamespace>AdvancedWizardControl</RootNamespace>
	</PropertyGroup>
	<ItemGroup>
		<Folder Include="Enums" />
		<Folder Include="EventArguments" />
		<Folder Include="Resources" />
		<Folder Include="Resources" />
		<Folder Include="Strategies" />
		<Folder Include="Wizard" />
		<Folder Include="WizardPages" />
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Include="Resources\AdvancedWizard.bmp" />
		<EmbeddedResource Include="Resources\wiz.gif" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net48'">
		<Reference Include="System.Design" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
		<Compile Remove="Wizard\AdvancedWizardDesigner.cs" />
		<Compile Remove="Wizard\AdvancedWizardPageDesigner.cs" />
		<Compile Remove="Wizard\AdvancedWizardCollectionEditor.cs" />
	</ItemGroup>
</Project>